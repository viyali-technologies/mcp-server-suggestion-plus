# stdio (default) or sse
TRANSPORT=stdio

# Used only when TRANSPORT=sse
HOST=127.0.0.1
PORT=3000

# Standard ADC setup: point to a credential configuration/key file, or leave unset
# to use local ADC or the workload's attached identity.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-play-credentials.json

# Optional app-specific fallback; accepts service-account JSON contents or a file path.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# App Store Connect credentials (adapter not implemented yet).
# APP_STORE_ISSUER_ID=
# APP_STORE_KEY_ID=
# APP_STORE_PRIVATE_KEY=
